  <data name="\obj_gui.Draw1.cs" xml:space="preserve">
    <value>/// draw hp bar
const width = 200, height = 55, frameThickness = 6
const barX = getViewWidth(0) / 2 - width / 2 + getViewX(0), barY = 10 + getViewY(0)
const hp = obj_player.i.hp

// draw the bar
setColor(colorFromRGB(255 - hp, 155 + hp, 0))
drawRect(barX + frameThickness, barY + frameThickness, barX + width - frameThickness - (100 - hp) * (width / 100), barY + height - frameThickness, false)

// draw the bar frame
setColor(Color.black)
drawRect(barX, barY, barX + width, barY + height, true, frameThickness)

// write the hp in the center
setFont(Fonts.fnt_hp)
drawText(barX + width / 2 - getTextWidth(hp) / 2, barY + height / 2 - getTextHeight(hp) / 2, hp)</value>
  </data>
  <data name="\obj_gui.Draw2.cs" xml:space="preserve">
    <value>/// draw items counters
const viewX = getViewX(0), viewY = getViewY(0)

// draw keys counter
drawSprite(viewX + keyIconLoc.x, viewY + keyIconLoc.y, Sprites.spr_key, 0)
drawText(viewX + keyIconLoc.x + 40, viewY + keyIconLoc.y, Items.keys)

// draw coins counter
drawSprite(viewX + coinIconLoc.x, viewY + coinIconLoc.y, Sprites.spr_coin, 0)
drawText(viewX + coinIconLoc.x + 30, viewY + coinIconLoc.y + 2, Items.coins)</value>
  </data>
  <data name="\obj_gui.Draw3.cs" xml:space="preserve">
    <value>/// draw touch buttons
#If MOBILE
foreach btn in obj_player.i.touchButtons
{
    btn.draw()
}
#EndIf</value>
  </data>
  <data name="\obj_gui.Create0.cs" xml:space="preserve">
    <value>/// set view port to fill screen on mobile devices
#If MOBILE
const screenWidth = getWindowWidth(), screenHeight = getWindowHeight()

setViewPortWidth(0, screenWidth)
setViewPortHeight(0, screenHeight)

const relation = getViewWidth(0) / screenWidth
setViewWidth(0, getViewWidth(0))
setViewHeight(0, relation * screenHeight)
bgHeight = math::min(bgHeight, getViewPortHeight(0) / 15)

setViewFollowingVBor(0, getViewHeight(0) / 1.5)
#EndIf</value>
  </data>
