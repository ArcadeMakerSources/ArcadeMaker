      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events /&gt;
      &lt;extraProperties /&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_player&lt;/name&gt;
      &lt;sprite&gt;spr_player_idle&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;-3&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// set animation speed
imageSpeed = idleAnimSpd&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// create GUI object and touch buttons
using gui

createInstance(0, 0, &amp;lt;obj_gui&amp;gt;)

// add buttons on mobile devices
#If MOBILE
const btnY = getViewHeight(0) - 74
rightBtn  = new TouchButton(95, btnY, "&amp;gt;")
leftBtn   = new TouchButton(20, btnY, "&amp;lt;")
jumpBtn   = new TouchButton(getViewWidth(0) - 84, btnY, "^")
attackBtn = new TouchButton(getViewWidth(0) - 84, btnY - 84, "ATTACK")
touchButtons = [rightBtn, leftBtn, jumpBtn, attackBtn]
#EndIf&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Step&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// movements

// input
#If MOBILE
if !rightWasPressed &amp;amp; rightBtn.isPressed()
#Else
if keyPress(Keys.right)
#EndIf
{
    rightWasPressed = true
    if !isAttacking &amp;amp; spriteID == Sprites.spr_player_idle
    {
        y -= 4
        spriteID = Sprites.spr_player_walk
        imageSpeed = walkAnimSpd
    }
    imageXScale = 1
}
#If MOBILE
if !leftWasPressed &amp;amp; leftBtn.isPressed()
#Else
if keyPress(Keys.left)
#EndIf
{
    leftWasPressed = true
    if !isAttacking &amp;amp; spriteID == Sprites.spr_player_idle
    {
        y -= 4
        spriteID = Sprites.spr_player_walk
        imageSpeed = walkAnimSpd
    }
    imageXScale = -1
}

#If MOBILE
if rightBtn.isPressed()
#Else
if keyDown(Keys.right)
#EndIf
{
    movespeed = 7
}
#If MOBILE
if leftBtn.isPressed()
#Else
if keyDown(Keys.left)
#EndIf
{
    movespeed = -7
}

#If MOBILE
if rightWasPressed &amp;amp; !rightBtn.isPressed()
#Else
if keyRelease(Keys.right)
#EndIf
{
    rightWasPressed = false
    if !isAttacking &amp;amp; spriteID == Sprites.spr_player_walk &amp;amp; !keyDown(Keys.left)
    {
        y += 4
        spriteID = Sprites.spr_player_idle
        imageSpeed = idleAnimSpd
    }
    movespeed = 0
}
#If MOBILE
if leftWasPressed &amp;amp; !leftBtn.isPressed()
#Else
if keyRelease(Keys.left)
#EndIf
{
    leftWasPressed = false
    if !isAttacking &amp;amp; spriteID == Sprites.spr_player_walk &amp;amp; !keyDown(Keys.right)
    {
        y += 4
        spriteID = Sprites.spr_player_idle
        imageSpeed = idleAnimSpd
    }
    movespeed = 0
}


// move
if !placeFree(x + movespeed, y)
{
   while placeFree(x + sign(movespeed), y)
   {
      x += sign(movespeed)
   }
}
else
{
    x += movespeed
}

// gravity
fallspeed += gra

if !placeFree(x, y + fallspeed)
{
    while placeFree(x, y + sign(fallspeed))
    {
        y += sign(fallspeed)
    }
    fallspeed = 0
}

y += fallspeed

// jump
#If MOBILE
if jumpBtn.isPressed()
#Else
if keyDown(Keys.up)
#EndIf
{
    if !placeFree(x, y + 1)
    {
        fallspeed -= jumpspeed
    }
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// attack
#If MOBILE
if attackBtn.isPressed()
#Else
if keyPress(Keys.space)
#EndIf
{
    if !isAttacking
    {
        isAttacking = true
        spriteID = Sprites.spr_player_attack
        imageSpeed = attackAnimSpd
        playSound(Sounds.snd_sword)
    }
}

// check end attack
if isAttacking &amp;amp; imageIndex == 5
{
    isAttacking = false
    
    // set sprite
    if movespeed != 0
    {
        spriteID = Sprites.spr_player_walk
        imageSpeed = walkAnimSpd
        y -= 4
    }
    else
    {
        spriteID = Sprites.spr_player_idle
        imageSpeed = idleAnimSpd
    }
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;idleAnimSpd&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;7&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;walkAnimSpd&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;4&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;attackAnimSpd&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;5&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;movespeed&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;0&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;jumpspeed&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;15&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;fallspeed&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;0&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;gra&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;1&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;isAttacking&lt;/Name&gt;
          &lt;Type&gt;Bool&lt;/Type&gt;
          &lt;InitValueCode&gt;false&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;hp&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;100&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;touchButtons&lt;/Name&gt;
          &lt;Type&gt;Array&lt;/Type&gt;
          &lt;InitValueCode&gt;[]&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;rightBtn&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;null&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;leftBtn&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;null&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;jumpBtn&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;null&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;attackBtn&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;null&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;rightWasPressed&lt;/Name&gt;
          &lt;Type&gt;Bool&lt;/Type&gt;
          &lt;InitValueCode&gt;false&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;leftWasPressed&lt;/Name&gt;
          &lt;Type&gt;Bool&lt;/Type&gt;
          &lt;InitValueCode&gt;false&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
      &lt;/extraProperties&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_orc&lt;/name&gt;
      &lt;sprite&gt;spr_orc_idle&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;-1&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// set animation speed
imageSpeed = idleAnimSpd&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// define attack()
attack = func()
{
    if this.getAlarm(2) &amp;lt; 0
    {
        spriteID = Sprites.spr_orc_attack
        imageSpeed = attackAnimSpd
        isAttacking = true
        this.setAlarm(2, 80)
    }
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// fall down
// bc orcs and walls don't share the same sprite size,
// we put the orcs a bit above th floor in the room editor.
// this script make them fall down to the fllor when created
while !placeMeeting(x, y + 6, &amp;lt;obj_block&amp;gt;)
{
    y++
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Step&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// movements
game::enemysMovements(this)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// strategy
game::enemysStrategy(this, 300)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfInt32"&gt;
          &lt;Type&gt;Alarm&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// destroy self
destroy()&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;0&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfInt32"&gt;
          &lt;Type&gt;Alarm&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// disable hit effect
imageAlpha = Color.white&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;1&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;idleAnimSpd&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;7&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;attack&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;null&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;isAttacking&lt;/Name&gt;
          &lt;Type&gt;Bool&lt;/Type&gt;
          &lt;InitValueCode&gt;false&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;attackAnimSpd&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;4&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;movespeed&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;0&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;maxMoveSpeed&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;4&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;spr_idle&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;Sprites.spr_orc_idle&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;spr_walk&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;Sprites.spr_orc_walk&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;spr_death&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;Sprites.spr_orc_death&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;hp&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;5&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;isDead&lt;/Name&gt;
          &lt;Type&gt;Bool&lt;/Type&gt;
          &lt;InitValueCode&gt;false&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
      &lt;/extraProperties&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_gui&lt;/name&gt;
      &lt;sprite /&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;-10&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Draw&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// draw background
setColor(Color.brown)
const viewX = getViewX(0), viewY = getViewY(0)
drawRect(viewX, viewY, viewX + getViewWidth(0), viewY + bgHeight, false)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// draw hp bar
const width = 200, height = 55, frameThickness = 6
const barX = getViewWidth(0) / 2 - width / 2 + getViewX(0), barY = 10 + getViewY(0)
const hp = obj_player.i.hp

// draw the bar
setColor(colorFromRGB(255 - hp, 155 + hp, 0))
drawRect(barX + frameThickness, barY + frameThickness, barX + width - frameThickness - (100 - hp) * (width / 100), barY + height - frameThickness, false)

// draw the bar frame
setColor(Color.black)
drawRect(barX, barY, barX + width, barY + height, true, frameThickness)

// write the hp in the center
setFont(Fonts.fnt_hp)
drawText(barX + width / 2 - getTextWidth(hp) / 2, barY + height / 2 - getTextHeight(hp) / 2, hp)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// draw items counters
const viewX = getViewX(0), viewY = getViewY(0)

// draw keys counter
drawSprite(viewX + keyIconLoc.x, viewY + keyIconLoc.y, Sprites.spr_key, 0)
drawText(viewX + keyIconLoc.x + 40, viewY + keyIconLoc.y, Items.keys)

// draw coins counter
drawSprite(viewX + coinIconLoc.x, viewY + coinIconLoc.y, Sprites.spr_coin, 0)
drawText(viewX + coinIconLoc.x + 30, viewY + coinIconLoc.y + 2, Items.coins)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// draw touch buttons
#If MOBILE
foreach btn in obj_player.i.touchButtons
{
    btn.draw()
}
#EndIf&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs&gt;
            &lt;string&gt;currentViewIndex&lt;/string&gt;
          &lt;/ScriptArgs&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// set view port to fill screen on mobile devices
#If MOBILE
const screenWidth = getWindowWidth(), screenHeight = getWindowHeight()

setViewPortWidth(0, screenWidth)
setViewPortHeight(0, screenHeight)

const relation = getViewWidth(0) / screenWidth
setViewWidth(0, getViewWidth(0))
setViewHeight(0, relation * screenHeight)
bgHeight = math::min(bgHeight, getViewPortHeight(0) / 15)

setViewFollowingVBor(0, getViewHeight(0) / 1.5)
#EndIf&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;keyIconLoc&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;new gui::Point(100, 32)&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;coinIconLoc&lt;/Name&gt;
          &lt;Type&gt;Any&lt;/Type&gt;
          &lt;InitValueCode&gt;new gui::Point(500, 32)&lt;/InitValueCode&gt;
          &lt;Constant&gt;true&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;bgHeight&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;100&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
