    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_torch&lt;/name&gt;
      &lt;sprite&gt;spr_torch&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// set animation speed
imageSpeed = 5&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties /&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_chest&lt;/name&gt;
      &lt;sprite&gt;spr_chest&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;1&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// disable animation
imageSpeed = 0&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfKeys"&gt;
          &lt;Type&gt;KeyPress&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// open
using math

if Items.keys &amp;gt;= 1 &amp;amp; placeMeeting(x, y, &amp;lt;obj_player&amp;gt;)
{
    Items.keys--
    
    // if content is null, create random number of coins
    if content == null
    {
        content = new Array(random(5, 21))
        foreach x in content : counter c
        {
            content[c] = &amp;lt;obj_coin&amp;gt;
        }
    }
    
    setAlarm(0, 10)
    
    imageIndex = 1
    
    playSound(Sounds.snd_open)
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;LeftShift&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfInt32"&gt;
          &lt;Type&gt;Alarm&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// collect next item
if currentItemIndex &amp;lt; content.length()
{
    const item = createInstance(x, y, content[currentItemIndex])
    collectItem(item)
    currentItemIndex++
    setAlarm(0, 10)
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;0&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;content&lt;/Name&gt;
          &lt;Type&gt;Array&lt;/Type&gt;
          &lt;InitValueCode&gt;null&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;false&lt;/Private&gt;
          &lt;Nullable&gt;true&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
        &lt;ObjectProperty&gt;
          &lt;Name&gt;currentItemIndex&lt;/Name&gt;
          &lt;Type&gt;Number&lt;/Type&gt;
          &lt;InitValueCode&gt;0&lt;/InitValueCode&gt;
          &lt;Constant&gt;false&lt;/Constant&gt;
          &lt;Private&gt;true&lt;/Private&gt;
          &lt;Nullable&gt;false&lt;/Nullable&gt;
        &lt;/ObjectProperty&gt;
      &lt;/extraProperties&gt;
    &lt;/SerializeableGameItem&gt;
