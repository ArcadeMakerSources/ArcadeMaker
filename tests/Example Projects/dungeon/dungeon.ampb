  <data name="\enemysStrategy.cs" xml:space="preserve">
    <value>func enemysStrategy(enemy, range)
{
    if enemy.isDead
    {
        // stop animation on last frame
        if enemy.imageIndex == 3
        {
            enemy.imageSpeed = 0
        }
        
        return null
    }
    
    const player = obj_player.i
    
    // if the enemy is currently attacking, and it's the last frame of the attack, end it
    if enemy.isAttacking
    {
        const img = enemy.imageIndex
        if img == 5
        {
            enemy.isAttacking = false
            enemy.spriteID = enemy.movespeed == 0 ? enemy.spr_idle : enemy.spr_walk
        }
        else 
        {
            if img == 2 &amp; player.getAlarm(2) &lt; 0 // half a way
            {
                // if it's colliding with the player, make damage to the player
                if enemy.placeMeeting(enemy.x, enemy.y, player)
                {
                    player.hp--
                    player.setAlarm(2, 80)
                }
            }
        }
    }
    else
    {
        // if the player is close enough, move towards it
        const minDistance = 60, distance = distanceBetweenObjects(enemy, player)
        if distance &lt;= range
        {
            if distance &lt; minDistance
            {
                enemy.attack()
            }
            else
            {
                if enemy.movespeed == 0
                {
                    enemy.spriteID = enemy.spr_walk
                }
        
                if player.x &lt; enemy.x
                {
                    enemy.movespeed = 0 - enemy.maxMoveSpeed
                }
                else
                {
                    enemy.movespeed = enemy.maxMoveSpeed
                }
        
                enemy.imageXScale = sign(enemy.movespeed)
            }
        }
        else
        {
            enemy.movespeed = 0
            enemy.spriteID = enemy.spr_idle
        }
    }
    
    // if colliding with the player while it's attacking, make damage
    if player.isAttacking &amp; enemy.getAlarm(1) &lt; 0 &amp; enemy.placeMeeting(enemy.x, enemy.y, player)
    {
        enemy.hp--
        if enemy.hp == 0
        {
            killEnemy(enemy)
        }
        else
        {
            enemy.imageAlpha = Color.red
            enemy.setAlarm(1, 30)
        }
    }
}</value>
  </data>
  <data name="\enemysMovements.cs" xml:space="preserve">
    <value>func enemysMovements(enemy)
{
    if enemy.isDead | enemy.isAttacking
    {
        return null
    }
    
    // move by strategy
    if enemy.movespeed != 0
    {
        if enemy.placeFree(enemy.x + enemy.movespeed, enemy.y)
        {
            enemy.x += enemy.movespeed
        }
        else
        {
            const moveSpeedSign = sign(enemy.movespeed)
            while enemy.placeFree(enemy.x + moveSpeedSign, enemy.y)
            {
                enemy.x += moveSpeedSign
            }
        }
    }
}</value>
  </data>
  <data name="\killEnemy.cs" xml:space="preserve">
    <value>func killEnemy(enemy)
{
    enemy.isDead = true
    enemy.spriteID = enemy.spr_death
    enemy.imageSpeed = 5
    enemy.setAlarm(0, 160)
}</value>
  </data>
