  <data name="\moveCollectedItemToGui.cs" xml:space="preserve">
    <value>namespace gui:

func moveCollectedItemToGui(item, guiLoc)
{
    if item.collected
    {
        const toX = guiLoc.x + getViewX(0), toY = guiLoc.y + getViewY(0)
        if item.pointMeeting(toX, toY)
        {
            item.destroy()
            item.getItem()
        }
        else
        {
            item.moveTowardsPoint(getViewX(0) + guiLoc.x, getViewY(0) + guiLoc.y, 10)
        }
    }
}</value>
  </data>
  <data name="\collectItem.cs" xml:space="preserve">
    <value>func collectItem(item)
{
    collectItem(item, Sounds.snd_collect)
}

func collectItem(item, sound)
{
    if !item.collected
    {
        item.collected = true
        item.depth = obj_gui.i.depth - 1
    
        playSound(sound)
    }
}</value>
  </data>
  <data name="\TouchButton.cs" xml:space="preserve">
    <value>namespace gui:

class TouchButton (x, y, const text, const textWidth private, const textHeight private)
{
    static const color = colorFromRGB(255, 255, 255, 150)
    static const width = 64
    static const height = 64
    
    constructor(x, y, text?)
    {
        this.x = x
        this.y = y
        this.text = text
        textWidth = getTextWidth(text)
        textHeight = getTextHeight(text)
    }
    
    func isPressed()
    {
        const wx = getViewX(0) + x, wy = getViewY(0) + y
        
        foreach loc in getTouchCollection(true)
        {
            if loc.x &gt;= wx &amp; loc.y &gt;= wy &amp; loc.x &lt;= wx + width &amp; loc.y &lt;= wy + height
            {
                return true
            }
        }
        return false
    }
    
    func draw()
    {
        const pressed = isPressed(), wx = getViewX(0) + x, wy = getViewY(0) + y
        
        setColor(pressed ? Color.white : color)
        drawRect(wx, wy, wx + width, wy + height, false)
        setColor(pressed ? Color.black : Color.white)
        drawText(wx + width / 2 - textWidth / 2, wy + height / 2 - textHeight / 2, text)
    }
}</value>
  </data>
  <data name="\obj_player.Create0.cs" xml:space="preserve">
    <value>/// set animation speed
imageSpeed = idleAnimSpd</value>
  </data>
  <data name="\obj_player.Create1.cs" xml:space="preserve">
    <value>/// create GUI object and touch buttons
using gui

createInstance(0, 0, &lt;obj_gui&gt;)

// add buttons on mobile devices
#If MOBILE
const btnY = getViewHeight(0) - 74
rightBtn  = new TouchButton(95, btnY, "&gt;")
leftBtn   = new TouchButton(20, btnY, "&lt;")
jumpBtn   = new TouchButton(getViewWidth(0) - 84, btnY, "^")
attackBtn = new TouchButton(getViewWidth(0) - 84, btnY - 84, "ATTACK")
touchButtons = [rightBtn, leftBtn, jumpBtn, attackBtn]
#EndIf</value>
  </data>
  <data name="\obj_player.Step0.cs" xml:space="preserve">
    <value>/// movements

// input
#If MOBILE
if !rightWasPressed &amp; rightBtn.isPressed()
#Else
if keyPress(Keys.right)
#EndIf
{
    rightWasPressed = true
    if !isAttacking &amp; spriteID == Sprites.spr_player_idle
    {
        y -= 4
        spriteID = Sprites.spr_player_walk
        imageSpeed = walkAnimSpd
    }
    imageXScale = 1
}
#If MOBILE
if !leftWasPressed &amp; leftBtn.isPressed()
#Else
if keyPress(Keys.left)
#EndIf
{
    leftWasPressed = true
    if !isAttacking &amp; spriteID == Sprites.spr_player_idle
    {
        y -= 4
        spriteID = Sprites.spr_player_walk
        imageSpeed = walkAnimSpd
    }
    imageXScale = -1
}

#If MOBILE
if rightBtn.isPressed()
#Else
if keyDown(Keys.right)
#EndIf
{
    movespeed = 7
}
#If MOBILE
if leftBtn.isPressed()
#Else
if keyDown(Keys.left)
#EndIf
{
    movespeed = -7
}

#If MOBILE
if rightWasPressed &amp; !rightBtn.isPressed()
#Else
if keyRelease(Keys.right)
#EndIf
{
    rightWasPressed = false
    if !isAttacking &amp; spriteID == Sprites.spr_player_walk &amp; !keyDown(Keys.left)
    {
        y += 4
        spriteID = Sprites.spr_player_idle
        imageSpeed = idleAnimSpd
    }
    movespeed = 0
}
#If MOBILE
if leftWasPressed &amp; !leftBtn.isPressed()
#Else
if keyRelease(Keys.left)
#EndIf
{
    leftWasPressed = false
    if !isAttacking &amp; spriteID == Sprites.spr_player_walk &amp; !keyDown(Keys.right)
    {
        y += 4
        spriteID = Sprites.spr_player_idle
        imageSpeed = idleAnimSpd
    }
    movespeed = 0
}


// move
if !placeFree(x + movespeed, y)
{
   while placeFree(x + sign(movespeed), y)
   {
      x += sign(movespeed)
   }
}
else
{
    x += movespeed
}

// gravity
fallspeed += gra

if !placeFree(x, y + fallspeed)
{
    while placeFree(x, y + sign(fallspeed))
    {
        y += sign(fallspeed)
    }
    fallspeed = 0
}

y += fallspeed

// jump
#If MOBILE
if jumpBtn.isPressed()
#Else
if keyDown(Keys.up)
#EndIf
{
    if !placeFree(x, y + 1)
    {
        fallspeed -= jumpspeed
    }
}</value>
  </data>
  <data name="\obj_player.Step1.cs" xml:space="preserve">
    <value>/// attack
#If MOBILE
if attackBtn.isPressed()
#Else
if keyPress(Keys.space)
#EndIf
{
    if !isAttacking
    {
        isAttacking = true
        spriteID = Sprites.spr_player_attack
        imageSpeed = attackAnimSpd
        playSound(Sounds.snd_sword)
    }
}

// check end attack
if isAttacking &amp; imageIndex == 5
{
    isAttacking = false
    
    // set sprite
    if movespeed != 0
    {
        spriteID = Sprites.spr_player_walk
        imageSpeed = walkAnimSpd
        y -= 4
    }
    else
    {
        spriteID = Sprites.spr_player_idle
        imageSpeed = idleAnimSpd
    }
}</value>
  </data>
