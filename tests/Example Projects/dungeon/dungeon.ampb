  <data name="\obj_orc.Create1.cs" xml:space="preserve">
    <value>/// define attack()
attack = func()
{
    if this.getAlarm(2) &lt; 0
    {
        spriteID = Sprites.spr_orc_attack
        imageSpeed = attackAnimSpd
        isAttacking = true
        this.setAlarm(2, 80)
    }
}</value>
