    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_blood&lt;/name&gt;
      &lt;sprite&gt;spr_blood&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Step&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// delete at the end
if imageIndex == 19
{
    destroy()
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties /&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameRoom"&gt;
      &lt;name&gt;rm_title&lt;/name&gt;
