              &lt;Value&gt;/// kill the player
killPlayer(other)
playSound(Sounds.snd_death)
createInstance(other.x, other.y, &amp;lt;obj_blood&amp;gt;)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs&gt;
            &lt;string&gt;other&lt;/string&gt;
          &lt;/ScriptArgs&gt;
