  <data name="\obj_portal.Create0.cs" xml:space="preserve">
    <value>/// set range and find twin portal
while placeFree(x, y + range)
{
    range += height
}

if twinPortal == null
{
    twinPortal = nearestInstance(x, y, &lt;obj_portal&gt;, this)
    twinPortal.twinPortal = this
}</value>
  </data>
  <data name="\obj_portal.Draw0.cs" xml:space="preserve">
    <value>/// draw gate
for (var yy = y; yy &lt;= y + range - 1; yy += height)
{
    drawSprite(x, yy, Sprites.spr_gate, 0)
}</value>
  </data>
  <data name="\obj_portal.Step0.cs" xml:space="preserve">
    <value>/// detect collision and launch to nearest portal
foreach player in obj_player.all()
{
    if player.x &gt;= x &amp; player.x &lt;= x + 8 &amp; player.y &gt;= y &amp; player.y &lt;= y + range
    {
        player.x = twinPortal.x + 9
        player.y = twinPortal.y + (player.y - y)
    }
}</value>
  </data>
  <data name="\obj_rotating_cutter.Step0.cs" xml:space="preserve">
    <value>/// rotate
imageAngle += 4</value>
  </data>
  <data name="\obj_rotating_cutter.Collision_obj_player0.cs" xml:space="preserve">
    <value>/// kill the player
killPlayer(other)
playSound(Sounds.snd_death)
createInstance(other.x, other.y, &lt;obj_blood&gt;)</value>
  </data>
  <data name="\obj_title.Draw0.cs" xml:space="preserve">
    <value>/// draw screen
using gui

// draw background
drawSprite(0, 120, Sprites.spr_background, 0)

// draw title
setFont(Fonts.fnt_title)
setColor(Color.yellow)
drawText(100, 50, "Run, Boy, Run!")

// draw players
setColor(0x22F5F5F5)
drawLine(0, y + 70, getRoomWidth(), y + 70, 200)
foreach btn in PlayerButton.all
{
    btn.draw()
}

// draw instructions
setFont(Fonts.fnt_keys)
setColor(Color.brown)
drawText(100, y - 24, "To select a key, hold the key and click the key icon.")

// draw subtitle
if subtitleVisible
{
    setFont(Fonts.fnt_subtitle)
    setColor(Color.green)
    const text = "Press ENTER to start the game"
    drawText(getRoomWidth() / 2 - getTextWidth(text) / 2, 400, text)
}</value>
  </data>
  <data name="\obj_title.Create0.cs" xml:space="preserve">
    <value>/// init subtitle alarm
setAlarm(0, 1)</value>
  </data>
  <data name="\obj_title.Create1.cs" xml:space="preserve">
    <value>/// init player buttons
using gui
using game

// if it's not the first round, skip this
if Global.wasInit
{
    return null
}

Global.wasInit = true

// the number of colors in this array must be equal or greater that maxPlayers:
const colors = [Color.white, Color.green, Color.blue, Color.yellow, Color.black, Color.lime]

// create the buttons
for (var c = 0; c &lt;= maxPlayers - 1; c++)
{
    const btn = new PlayerButton(Keys.z, colors[c], 100 + c * 100, y)
}

// check the first button and disable unchecking
PlayerButton.all.get(0).checkBox.checked = true
PlayerButton.all.get(0).checkBox.enabled = false</value>
  </data>
  <data name="\obj_title.Create2.cs" xml:space="preserve">
    <value>/// play title music
playSound(Sounds.snd_title, true)</value>
  </data>
  <data name="\obj_title.Alarm_00.cs" xml:space="preserve">
    <value>/// change subtitle visible state
subtitleVisible = !subtitleVisible
setAlarm(0, 30)</value>
  </data>
  <data name="\obj_title.KeyPress_Enter0.cs" xml:space="preserve">
    <value>/// start the game
using gui

const playersData = new List()
foreach btn in PlayerButton.all
{
    if btn.isChecked()
    {
        playersData.add(new PlayerData(btn.key, btn.color))
    }
}
PlayerData.all = playersData

goToNextRoom()</value>
  </data>
  <data name="\obj_title.Step0.cs" xml:space="preserve">
    <value>/// fire onMouseClick
if mouseButtonPress(MouseButton.left)
{
    foreach fn in Global.onTitleMouseClick
    {
        fn(getMouseX(), getMouseY())
    }
}</value>
  </data>
  <data name="\obj_pathend.Collision_obj_player0.cs" xml:space="preserve">
    <value>/// if it's the last, go to next level
other.destroy()
if instanceCount(&lt;obj_player&gt;) == 0
{
    setAlarm(0, 120)
}

playSound(Sounds.snd_finish)</value>
  </data>
  <data name="\obj_pathend.Alarm_00.cs" xml:space="preserve">
    <value>/// next level
goToNextRoom()</value>
  </data>
  <data name="\obj_scores_board.Draw0.cs" xml:space="preserve">
    <value>/// draw board

// draw title
setFont(Fonts.fnt_title)
setColor(Color.red)
var text = "Scores:"
drawText(getRoomWidth() / 2 - getTextWidth(text) / 2, 50, text)

// draw board
setFont(Fonts.fnt_scores)
setColor(Color.gold)
foreach data in PlayerData.all : counter c
{
    drawSprite(100, 150 + c * 50, Sprites.spr_player_right, 0, 0, data.color)
    drawText(170, 130 + c * 50, data.score)
}

// draw instructions
setFont(Fonts.fnt_subtitle)
setColor(Color.green)
text = "Press ENTER to play again"
drawText(getRoomWidth() / 2 - getTextWidth(text) / 2, 400, text)</value>
  </data>
