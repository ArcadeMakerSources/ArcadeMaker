      &lt;name&gt;obj_pathend&lt;/name&gt;
      &lt;sprite&gt;spr_pathend&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent xsi:type="CollisionEvent"&gt;
          &lt;Type&gt;Collision&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// if it's the last, go to next level
other.destroy()
if instanceCount(&amp;lt;obj_player&amp;gt;) == 0
{
    setAlarm(0, 120)
}

playSound(Sounds.snd_finish)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs&gt;
            &lt;string&gt;other&lt;/string&gt;
          &lt;/ScriptArgs&gt;
          &lt;Param&gt;obj_player&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfInt32"&gt;
          &lt;Type&gt;Alarm&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// next level
goToNextRoom()&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;0&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties /&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_scores_board&lt;/name&gt;
      &lt;sprite /&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Draw&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// draw board

// draw title
setFont(Fonts.fnt_title)
setColor(Color.red)
var text = "Scores:"
drawText(getRoomWidth() / 2 - getTextWidth(text) / 2, 50, text)

// draw board
setFont(Fonts.fnt_scores)
setColor(Color.gold)
foreach data in PlayerData.all : counter c
{
    drawSprite(100, 150 + c * 50, Sprites.spr_player_right, 0, 0, data.color)
    drawText(170, 130 + c * 50, data.score)
}

// draw instructions
setFont(Fonts.fnt_subtitle)
setColor(Color.green)
text = "Press ENTER to play again"
drawText(getRoomWidth() / 2 - getTextWidth(text) / 2, 400, text)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs&gt;
            &lt;string&gt;currentViewIndex&lt;/string&gt;
          &lt;/ScriptArgs&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfKeys"&gt;
          &lt;Type&gt;KeyPress&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// restart game
goToRoom(Rooms.rm_title)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;Enter&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// sort best scores
PlayerData.sort()&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
