    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_title&lt;/name&gt;
      &lt;sprite /&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Draw&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// draw screen
using gui

// draw background
drawSprite(0, 120, Sprites.spr_background, 0)

// draw title
setFont(Fonts.fnt_title)
setColor(Color.yellow)
drawText(100, 50, "Run, Boy, Run!")

// draw players
setColor(0x22F5F5F5)
drawLine(0, y + 70, getRoomWidth(), y + 70, 200)
foreach btn in PlayerButton.all
{
    btn.draw()
}

// draw instructions
setFont(Fonts.fnt_keys)
setColor(Color.brown)
drawText(100, y - 24, "To select a key, hold the key and click the key icon.")

// draw subtitle
if subtitleVisible
{
    setFont(Fonts.fnt_subtitle)
    setColor(Color.green)
    const text = "Press ENTER to start the game"
    drawText(getRoomWidth() / 2 - getTextWidth(text) / 2, 400, text)
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs&gt;
            &lt;string&gt;currentViewIndex&lt;/string&gt;
          &lt;/ScriptArgs&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// init subtitle alarm
setAlarm(0, 1)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// init player buttons
using gui
using game

// if it's not the first round, skip this
if Global.wasInit
{
    return null
}

Global.wasInit = true

// the number of colors in this array must be equal or greater that maxPlayers:
const colors = [Color.white, Color.green, Color.blue, Color.yellow, Color.black, Color.lime]

// create the buttons
for (var c = 0; c &amp;lt;= maxPlayers - 1; c++)
{
    const btn = new PlayerButton(Keys.z, colors[c], 100 + c * 100, y)
}

// check the first button and disable unchecking
PlayerButton.all.get(0).checkBox.checked = true
PlayerButton.all.get(0).checkBox.enabled = false&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// play title music
playSound(Sounds.snd_title, true)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfInt32"&gt;
          &lt;Type&gt;Alarm&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// change subtitle visible state
subtitleVisible = !subtitleVisible
setAlarm(0, 30)&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;0&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent xsi:type="ParameterizedObjectEventOfKeys"&gt;
          &lt;Type&gt;KeyPress&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// start the game
using gui

const playersData = new List()
foreach btn in PlayerButton.all
{
    if btn.isChecked()
    {
        playersData.add(new PlayerData(btn.key, btn.color))
    }
}
PlayerData.all = playersData

goToNextRoom()&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
          &lt;Param&gt;Enter&lt;/Param&gt;
        &lt;/ObjectEvent&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Step&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// fire onMouseClick
if mouseButtonPress(MouseButton.left)
{
    foreach fn in Global.onTitleMouseClick
    {
        fn(getMouseX(), getMouseY())
    }
}&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
