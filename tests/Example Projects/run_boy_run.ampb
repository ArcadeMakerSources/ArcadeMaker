      &lt;name&gt;Global&lt;/name&gt;
      &lt;path&gt;\Global.cs&lt;/path&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameScript"&gt;
      &lt;name&gt;PlayerButton&lt;/name&gt;
      &lt;path&gt;\PlayerButton.cs&lt;/path&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameScript"&gt;
      &lt;name&gt;CheckBox&lt;/name&gt;
      &lt;path&gt;\CheckBox.cs&lt;/path&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameScript"&gt;
      &lt;name&gt;PlayerData&lt;/name&gt;
      &lt;path&gt;\PlayerData.cs&lt;/path&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_wall&lt;/name&gt;
      &lt;sprite&gt;spr_wall&lt;/sprite&gt;
      &lt;solid&gt;true&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Create&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// cancel animation
imageSpeed = 0&lt;/Value&gt;
            &lt;/WrapperOfString&gt;
          &lt;/Scripts&gt;
          &lt;ScriptArgs /&gt;
        &lt;/ObjectEvent&gt;
      &lt;/events&gt;
      &lt;extraProperties /&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameObject"&gt;
      &lt;name&gt;obj_player&lt;/name&gt;
      &lt;sprite&gt;spr_player_right&lt;/sprite&gt;
      &lt;solid&gt;false&lt;/solid&gt;
      &lt;depth&gt;0&lt;/depth&gt;
      &lt;events&gt;
        &lt;ObjectEvent&gt;
          &lt;Type&gt;Step&lt;/Type&gt;
          &lt;Scripts&gt;
            &lt;WrapperOfString&gt;
              &lt;Value&gt;/// movement
const vert = Global.viewDir == Dir.north | Global.viewDir == Dir.south
const spd = ((Global.viewDir == Dir.north | Global.viewDir == Dir.west) ? -1 : 1) * movespeed

// gravity
const isInTheAir = vert ? placeFree(x + gravity, y - spd) : placeFree(x - spd, y + gravity)
if isInTheAir
{
    if vert { x += gravity }
    else { y += gravity }
}
else
{
    const sgn = sign(gravity)
    while vert ? placeFree(x + sgn, y - spd) : placeFree(x - spd, y + sgn)
    {
        if vert { x += sgn }
        else { y += sgn }
    }
}

// level movement
if (vert ? !placeMeeting(x - sign(gravity), y + spd, &amp;lt;obj_wall&amp;gt;) : !placeMeeting(x + spd, y - sign(gravity), &amp;lt;obj_wall&amp;gt;))
{
    if vert { y += spd }
    else { x += spd }
}

// change gravity on key press
if keyPressed &amp;amp; !isInTheAir
{
    keyPressed = false
    gravity = gravity * -1
    spriteID = spriteID == Sprites.spr_player_right ? Sprites.spr_player_left : Sprites.spr_player_right
    imageAngle += 180
    playSound(Sounds.snd_gswitch)
}

// restart on outside view
if !firstStep &amp;amp; (vert ? (getViewY(0) + getViewHeight(0) &amp;lt;= y | getViewY(0) &amp;gt; y) : (getViewX(0) + getViewWidth(0) &amp;lt;= x | getViewX(0) &amp;gt; x))
{
    killPlayer(this)
}

firstStep = false

