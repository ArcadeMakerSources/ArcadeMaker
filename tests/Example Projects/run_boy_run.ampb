  <data name="*" xml:space="preserve">
    <value>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;SerializeableGameProject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
  &lt;name&gt;run_boy_run&lt;/name&gt;
  &lt;items&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameSprite"&gt;
      &lt;name&gt;spr_wall&lt;/name&gt;
      &lt;pathes&gt;
        &lt;string&gt;\res\spr_wall_strip15.png&lt;/string&gt;
      &lt;/pathes&gt;
      &lt;numOfImages&gt;15&lt;/numOfImages&gt;
      &lt;originX&gt;16&lt;/originX&gt;
      &lt;originY&gt;16&lt;/originY&gt;
      &lt;preciseMask&gt;false&lt;/preciseMask&gt;
      &lt;separateMask&gt;false&lt;/separateMask&gt;
      &lt;maskBounding_auto&gt;true&lt;/maskBounding_auto&gt;
      &lt;maskBounding_fullImage&gt;false&lt;/maskBounding_fullImage&gt;
      &lt;maskBounding_manual&gt;false&lt;/maskBounding_manual&gt;
      &lt;maskTop&gt;0&lt;/maskTop&gt;
      &lt;maskRight&gt;31&lt;/maskRight&gt;
      &lt;maskBottom&gt;31&lt;/maskBottom&gt;
      &lt;maskLeft&gt;0&lt;/maskLeft&gt;
      &lt;maskAlphaTolerance&gt;0&lt;/maskAlphaTolerance&gt;
    &lt;/SerializeableGameItem&gt;
    &lt;SerializeableGameItem xsi:type="SerializeableGameSprite"&gt;
      &lt;name&gt;spr_player_right&lt;/name&gt;
      &lt;pathes&gt;
        &lt;string&gt;\res\spr_player_right_strip6.png&lt;/string&gt;
      &lt;/pathes&gt;
      &lt;numOfImages&gt;6&lt;/numOfImages&gt;
      &lt;originX&gt;16&lt;/originX&gt;
      &lt;originY&gt;22&lt;/originY&gt;
      &lt;preciseMask&gt;false&lt;/preciseMask&gt;
      &lt;separateMask&gt;false&lt;/separateMask&gt;
      &lt;maskBounding_auto&gt;false&lt;/maskBounding_auto&gt;
      &lt;maskBounding_fullImage&gt;true&lt;/maskBounding_fullImage&gt;
      &lt;maskBounding_manual&gt;false&lt;/maskBounding_manual&gt;
