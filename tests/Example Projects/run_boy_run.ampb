  <data name="\Global.cs" xml:space="preserve">
    <value>namespace game:

class Global ()
{
    static viewDir
    static const onTitleMouseClick = new std::List()
    static wasInit = false
}

enum Dir
{
    east,
    west,
    north,
    south
}

func getViewDir(cameraDir)
{
    cameraDir = cameraDir % 360
    while cameraDir &lt; 0 { cameraDir += 360 }
    if cameraDir &lt;= 20 | cameraDir &gt;= 340 { return Dir.east  }
    if cameraDir &lt;= 110                   { return Dir.south }
    if cameraDir &lt;= 200                   { return Dir.west  }
    return Dir.north
}

func killPlayer(player)
{
    player.destroy()
    player.data.deathLevel = getRoomIndex()
    
    // if he was the only one left, go to next level / show scores
    if instanceCount(&lt;obj_player&gt;) == 0
    {
        obj_camera.i.setAlarm(0, 120)
    }
}

func abs(num)
{
    if num &lt; 0
    {
        return num * -1
    }
    return num
}

func negative(num)
{
    if num &gt; 0
    {
        return num * -1
    }
    return num
}</value>
  </data>
  <data name="\PlayerButton.cs" xml:space="preserve">
    <value>using std
using ArcadeMaker
using game
namespace gui:

class PlayerButton (key, color, x, y, checkBox)
{
    static const all = new List()
    
    constructor (key, color, x, y)
    {
        this.key = key
        this.color = color
        this.x = x
        this.y = y
        checkBox = new CheckBox(false, true, x + 10, y + 130)
        
        all.add(this)
        Global.onTitleMouseClick.add(this.onClick)
    }
    
    func isChecked() =&gt; checkBox.checked
    
    func onClick(mx, my)
    {
        // check if the keyboard key icon was pressed
        if mx &gt;= x &amp; mx &lt;= x + 42 &amp; my &gt;= y &amp; my &lt;= y + 42
        {
            const pressed = getPressedKey()
            if pressed != null
            {
                key = pressed
            }
        }
    }
    
    func draw()
    {
        // draw key icon
        drawSprite(x, y, Sprites.spr_keyboard_key, 0)
        
        // draw key
        setFont(Fonts.fnt_keys)
        setColor(Color.black)
        drawText(x + 10, y + 10, Keys.getValueName(key))
        
        // draw player
        drawSprite(x + 25, y + 90, Sprites.spr_player_right, 0, 0, color)
        
        // draw the check box
        checkBox.draw()
    }
}</value>
  </data>
  <data name="\CheckBox.cs" xml:space="preserve">
    <value>using ArcadeMaker
using game
namespace gui:

class CheckBox (checked, enabled, x, y)
{
    constructor(checked, enabled, x, y)
    {
        this.checked = checked
        this.enabled = enabled
        this.x = x
        this.y = y
        Global.onTitleMouseClick.add(this.onClick)
    }
    
    func onClick(mx, my)
    {
        if enabled &amp; mx &gt;= x &amp; mx &lt;= x + 26 &amp; my &gt;= y &amp; my &lt;= y + 26
        {
            checked = !checked
        }
    }
    
    func draw()
    {
        drawSprite(x, y, Sprites.spr_checkbox, checked ? 1 : 0, 0, enabled ? Color.white : Color.gray)
    }
}</value>
  </data>
  <data name="\PlayerData.cs" xml:space="preserve">
    <value>using std
namespace game:

class PlayerData (key, color, score, deathLevel)
{
    static all
    
    constructor (key, color)
    {
        this.key = key
        this.color = color
        score = 0
        deathLevel = null
    }
    
    static func sort()
    {
        const sortedLs = new List()
        
        while all.count() &gt; 0
        {
            var best = null, bestIndex = null
            
            foreach data in all : counter c
            {
                if best == null | data.score &gt; best.score
                {
                    best = data
                    bestIndex = c
                }
            }
            
            all.remove(bestIndex)
            sortedLs.add(best)
        }
        
        all = sortedLs
    }
}</value>
  </data>
  <data name="\obj_wall.Create0.cs" xml:space="preserve">
    <value>/// cancel animation
imageSpeed = 0</value>
  </data>
  <data name="\obj_player.Step0.cs" xml:space="preserve">
    <value>/// movement
const vert = Global.viewDir == Dir.north | Global.viewDir == Dir.south
const spd = ((Global.viewDir == Dir.north | Global.viewDir == Dir.west) ? -1 : 1) * movespeed

// gravity
const isInTheAir = vert ? placeFree(x + gravity, y - spd) : placeFree(x - spd, y + gravity)
if isInTheAir
{
    if vert { x += gravity }
    else { y += gravity }
}
else
{
    const sgn = sign(gravity)
    while vert ? placeFree(x + sgn, y - spd) : placeFree(x - spd, y + sgn)
    {
        if vert { x += sgn }
        else { y += sgn }
    }
}

// level movement
if (vert ? !placeMeeting(x - sign(gravity), y + spd, &lt;obj_wall&gt;) : !placeMeeting(x + spd, y - sign(gravity), &lt;obj_wall&gt;))
{
    if vert { y += spd }
    else { x += spd }
}

// change gravity on key press
if keyPressed &amp; !isInTheAir
{
    keyPressed = false
    gravity = gravity * -1
    spriteID = spriteID == Sprites.spr_player_right ? Sprites.spr_player_left : Sprites.spr_player_right
    imageAngle += 180
    playSound(Sounds.snd_gswitch)
}

// restart on outside view
if !firstStep &amp; (vert ? (getViewY(0) + getViewHeight(0) &lt;= y | getViewY(0) &gt; y) : (getViewX(0) + getViewWidth(0) &lt;= x | getViewX(0) &gt; x))
{
    killPlayer(this)
}

firstStep = false

// add score
data.score++</value>
  </data>
  <data name="\obj_player.Step1.cs" xml:space="preserve">
    <value>/// handle key press
if keyPress(key)
{
    // save key state
    keyPressed = true
}</value>
  </data>
  <data name="\obj_player.Create0.cs" xml:space="preserve">
    <value>/// set image speed
imageSpeed = 3</value>
  </data>
  <data name="\obj_camera.Create0.cs" xml:space="preserve">
    <value>/// create players
foreach data in PlayerData.all : counter c
{
    // if you want to only create the players who successfuly finished all previous levels, uncomment this:
/*
    if data.deathLevel != null &amp; data.deathLevel != getRoomIndex() { continue }
*/
    
    const player = createInstance(x, y + c * 32, &lt;obj_player&gt;)
    player.key = data.key
    player.imageAlpha = data.color
    player.data = data
}</value>
  </data>
  <data name="\obj_camera.Create1.cs" xml:space="preserve">
    <value>/// start level path
onPathStepFinished = func() // as for exp limits, this is a static function
{
    const camera = obj_camera.first
    const prevDir = Global.viewDir
    Global.viewDir = getViewDir(camera.direction)
    
    // change gravity for all players
    foreach player in obj_player.all()
    {
        player.movespeed = camera.speed &gt; 0 ? camera.speed : 5
        if prevDir == Dir.east | prevDir == Dir.south { player.gravity = abs(player.gravity) }
        else { player.gravity = negative(player.gravity) }
        player.keyPressed = false
        
        // set image angle &amp; sprite
        const gravityPos = player.gravity &gt; 0
        if Global.viewDir == Dir.east
        {
            player.imageAngle = gravityPos ? 0 : 180
            player.spriteID = gravityPos ? Sprites.spr_player_right : Sprites.spr_player_left
        }
        else { if Global.viewDir == Dir.south
        {
            player.imageAngle = gravityPos ? 270 : 90
            player.spriteID = gravityPos ? Sprites.spr_player_left : Sprites.spr_player_right
        }
        else { if Global.viewDir == Dir.west
        {
            player.imageAngle = gravityPos ? 0 : 180
            player.spriteID = gravityPos ? Sprites.spr_player_left : Sprites.spr_player_right
        }
        else { if Global.viewDir == Dir.north
        {
            player.imageAngle = gravityPos ? 270 : 90
            player.spriteID = gravityPos ? Sprites.spr_player_right : Sprites.spr_player_left
        } } } }
    }
}

startPath(getResByName("pth_level" + getRoomIndex()), 5, PathEndAction.stop, true)
onPathStepFinished() // init Global.viewDir</value>
  </data>
  <data name="\obj_camera.Draw0.cs" xml:space="preserve">
